# Public Base URL Configuration
# Set this to your app's public domain when deploying
# Example: VITE_PUBLIC_BASE_URL=https://growthtracker.com
# Leave empty to auto-detect from window.location
VITE_PUBLIC_BASE_URL=

# Maintenance Mode
# Set to enable maintenance mode (shows full-page downtime screen)
# Accepted values: true/1/on/yes (enable) or false/0/off/no (disable)
# Leave empty or unset to disable maintenance mode
# Note: Changes require a rebuild to take effect
VITE_MAINTENANCE_MODE=
